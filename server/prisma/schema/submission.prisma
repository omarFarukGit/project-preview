model Submission {
  id                String           @id @default(uuid())
  projectName       String
  repoUrl           String
  normalizedRepoUrl String
  liveUrl           String
  description       String
  status            SubmissionStatus @default(PENDING)

  studentId String
  student   User   @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Restrict)

  reviewedById String?
  reviewedBy   User?   @relation("MentorReviews", fields: [reviewedById], references: [id], onDelete: SetNull)

  feedbacks Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, normalizedRepoUrl])
  @@index([studentId, createdAt])
  @@index([status, createdAt])
  @@index([reviewedById])
  @@map("submissions")
}
